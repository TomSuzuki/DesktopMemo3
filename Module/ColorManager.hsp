// ------------------------------------------------------------
// 色設定を管理
// ------------------------------------------------------------

#const global ColorNum 8

#enum global ColorTypeText 0
#enum global ColorTypeTheme
#enum global ColorTypeBox
#enum global ColorTypeButton
#enum global ColorTypeButtonClick
#enum global ColorTypeButtonMouseOver

#define global ButtonColor          getColor(-1, ColorTypeButton)
#define global ButtonClickColor     getColor(-1, ColorTypeButtonClick)
#define global ButtonMouseOverColor getColor(-1, ColorTypeButtonMouseOver)

// 色管理モジュール
#module MOD_COLOR_OBJ text, theme, box

// コンストラクタ
#modinit int _text, int _theme, int _box
  text = _text
  theme = _theme
  box = _box
  return

// ゲッター
#modcfunc getObjTextColor
  return text
#modcfunc getObjThemeColor
  return theme
#modcfunc getObjBoxColor
  return box

#global

// 色関連の読み込み処理モジュール
#module

// LoadColor ...色を読込みます。
#deffunc LoadColor str _fname

  fname = _fname

  // ファイルがない場合は先頭に見つかったファイルにする
  exist fname
  if (strsize == -1) {
    sdim searchList, 256
    dirlist searchList, "./theme/*.json", 3
    notesel searchList
    noteget foundFile, 0
    fname = "./theme/" + foundFile
    noteunsel
  }

  // 読み込み
  notesel jsonText
  noteload fname
  noteunsel

  // 色管理モジュール初期化
  dimtype color_obj, vartype("struct")    // 色オブジェクト配列

  // JSON形式を開く
  jsonsel jsonText

  // JSONから読み込み（モジュール変数の順番は保証されるはず）
  repeat ColorNum
    text  = jsonget(str(cnt) + ",text")
    theme = jsonget(str(cnt) + ",theme")
    box   = jsonget(str(cnt) + ",box")
    newmod color_obj, MOD_COLOR_OBJ, int(text), int(theme), int(box)
  loop

  // テーマファイル側のボタンカラー設定を優先して読み込む
  buttonColor1 = jsonget("button_color")
  buttonColor2 = jsonget("button_color_click")
  buttonColor3 = jsonget("button_color_mouseover")
  if (buttonColor1 != "") : buttonColor1 = int(buttonColor1) : else : buttonColor1 = int("$666666")
  if (buttonColor2 != "") : buttonColor2 = int(buttonColor2) : else : buttonColor2 = int("$FFFFFF")
  if (buttonColor3 != "") : buttonColor3 = int(buttonColor3) : else : buttonColor3 = int("$AAAAAA")

  return

// getColor ...色を取得します。
#defcfunc getColor int _id, int _type
  c = 0
  if (_type == ColorTypeText)  : c = getObjTextColor(color_obj._id)
  if (_type == ColorTypeTheme) : c = getObjThemeColor(color_obj._id)
  if (_type == ColorTypeBox)   : c = getObjBoxColor(color_obj._id)
  if (_type == ColorTypeButton)          : c = buttonColor1
  if (_type == ColorTypeButtonClick)     : c = buttonColor2
  if (_type == ColorTypeButtonMouseOver) : c = buttonColor3
  return c

#global

