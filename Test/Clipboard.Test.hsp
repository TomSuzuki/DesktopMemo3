#runtime "hsp3utf"
#include "hsp3utf.as"

#include "../Common/Clipboard.as"
#include "./TestFrame.hsp"

// テストを初期化
InitTest "クリップボード操作のテスト"

// No.1 英数文字列
s = "ABC123"
ClipboardCopy s
TestRecord s, (ClipboardGet() == s)

// No.2 全角文字
s = "テストデータ"
ClipboardCopy s
TestRecord s, (ClipboardGet() == s)

// No.3 改行データ
s = "ABC\nあいう"
ClipboardCopy s
TestRecord s, (ClipboardGet() == s)

// No.4 絵文字
s = "寿司（🍣） 鍵（🔑）"
ClipboardCopy s
TestRecord s, (ClipboardGet() == s)

// 最終結果を出力
TestResult
