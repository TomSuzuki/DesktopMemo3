#runtime "hsp3cl"
#include "hspcmp.as"
#packopt name "build"

  // Change to the build target directory
  chdir "../"

  // Setup
  fname = "main.hsp"
  objname = "obj"

  // Compile
  hsc_ini fname
  hsc_objname objname
  hsc_comp 4, 36 // UTF8
  if stat {
    dialog "Compilation failed."
    end
  }

  // Build
  hsc3_make dir_exe + "\\" + "runtime" + "\\"
  if stat {
    dialog "Build failed."
	end
  }

  // Build complete
  dialog "Build completed."
  end
